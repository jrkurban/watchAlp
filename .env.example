# Optional. Protects the visitor log page at /logs?key=...
LOGS_KEY="syncwatch-logs"

# Optional override. Drive playback uses the Firebase web API key by default.
# Enable "Google Drive API" on the same Google Cloud project, and share files as
# Anyone with the link (Viewer). Restrict the key to Drive API + your domain.
# VITE_GOOGLE_API_KEY=""

# TURN relay so voice chat works across different home/mobile networks.
# STUN alone only works on the same Wi-Fi. Create a free app at https://metered.ca
# then paste the TURN URLs + username + credential. Also add these in Vercel → Settings → Environment Variables.
# VITE_TURN_URLS="turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:80?transport=tcp,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443"
# VITE_TURN_USERNAME=""
# VITE_TURN_CREDENTIAL=""
